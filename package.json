{
  "name": "buildlogic-governance-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "clean": "node scripts/clean-build-artifacts.cjs",
    "build": "pnpm clean && pnpm -r --filter \"./packages/*\" build",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "test": "pnpm -r --if-present test",
    "type-check": "pnpm -r --filter \"./packages/*\" build && pnpm -r --if-present type-check",
    "pack:check": "pnpm clean && pnpm -r --filter \"./packages/*\" build && pnpm -r --if-present pack:check",
    "pack:smoke": "node scripts/smoke-packed-packages.cjs",
    "verify": "pnpm run doctor && pnpm audit:dependencies && pnpm type-check && pnpm test && pnpm run test:doctor && pnpm build && pnpm pack:check && pnpm pack:smoke",
    "test:doctor": "node --test test/engineering-doctor.test.mjs",
    "doctor": "node bin/engineering-doctor.mjs"
  },
  "bin": {
    "engineering-doctor": "bin/engineering-doctor.mjs"
  }
}
