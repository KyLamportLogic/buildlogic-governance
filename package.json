{
  "name": "buildlogic-governance-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22.23.2" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "type-check": "pnpm --filter @kypython/buildlogic-governance build && pnpm -r --if-present type-check",
    "pack:check": "pnpm -r --if-present pack:check",
    "verify": "pnpm type-check && pnpm test && pnpm build && pnpm pack:check"
  }
}
