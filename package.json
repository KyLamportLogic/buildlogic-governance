{
  "name": "buildlogic-governance-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "clean": "node scripts/clean-build-artifacts.cjs",
    "build": "pnpm clean && pnpm -r build",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "test": "pnpm -r --if-present test",
    "type-check": "pnpm -r build && pnpm -r --if-present type-check",
    "pack:check": "pnpm clean && pnpm -r --if-present build && pnpm -r --if-present pack:check",
    "pack:smoke": "node scripts/smoke-packed-packages.cjs",
    "verify": "pnpm audit:dependencies && pnpm type-check && pnpm test && pnpm build && pnpm pack:check && pnpm pack:smoke"
  }
}
