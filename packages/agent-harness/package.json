{
  "name": "@kypython/buildlogic-agent-harness",
  "version": "0.1.0",
  "description": "Model-neutral, fail-close LLM provider harness with governance preflight and optional AIDR inspection",
  "license": "Apache-2.0",
  "keywords": ["ai-governance", "agent-harness", "llm", "fail-close", "mcp"],
  "homepage": "https://github.com/KyLamportLogic/buildlogic-governance#readme",
  "bugs": { "url": "https://github.com/KyLamportLogic/buildlogic-governance/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyLamportLogic/buildlogic-governance.git",
    "directory": "packages/agent-harness"
  },
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.js", "default": "./dist/index.js" },
    "./providers": { "types": "./dist/providers/index.d.ts", "import": "./dist/providers/index.js", "require": "./dist/providers/index.js", "default": "./dist/providers/index.js" },
    "./middleware": { "types": "./dist/middleware/index.d.ts", "import": "./dist/middleware/index.js", "require": "./dist/middleware/index.js", "default": "./dist/middleware/index.js" }
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc",
    "test": "jest --watchman=false",
    "type-check": "tsc --noEmit",
    "pack:check": "pnpm pack --pack-destination ../../.packs"
  },
  "dependencies": {
    "@kypython/buildlogic-agentic-security": "workspace:^",
    "@kypython/buildlogic-governance": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true },
    "openai": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.98.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.13",
    "jest": "29.7.0",
    "openai": "6.25.0",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  }
}
