{
  "name": "@kypython/buildlogic-agentic-security",
  "version": "0.1.0",
  "description": "Official-SDK security adapters for governed AI agents, audit retention, and runtime posture",
  "license": "Apache-2.0",
  "keywords": ["agentic-security", "ai-governance", "crowdstrike", "guardduty", "fail-close"],
  "homepage": "https://github.com/KyLamportLogic/buildlogic-governance#readme",
  "bugs": { "url": "https://github.com/KyLamportLogic/buildlogic-governance/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyLamportLogic/buildlogic-governance.git",
    "directory": "packages/agentic-security"
  },
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.js", "default": "./dist/index.js" }
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc",
    "test": "jest --watchman=false",
    "type-check": "tsc --noEmit",
    "pack:check": "pnpm pack --pack-destination ../../.packs"
  },
  "dependencies": {
    "@crowdstrike/aidr": "1.2.2",
    "@kypython/buildlogic-governance": "workspace:^"
  },
  "peerDependencies": {
    "@aws-sdk/client-guardduty": ">=3.0.0",
    "@aws-sdk/client-s3": ">=3.0.0",
    "@infisical/sdk": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-guardduty": { "optional": true },
    "@aws-sdk/client-s3": { "optional": true },
    "@infisical/sdk": { "optional": true }
  },
  "devDependencies": {
    "@aws-sdk/client-guardduty": "3.1103.0",
    "@aws-sdk/client-s3": "3.984.0",
    "@infisical/sdk": "5.0.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.13",
    "jest": "29.7.0",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/*.test.ts"],
    "haste": { "enableSymlinks": false }
  }
}
