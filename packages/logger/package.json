{
  "name": "@kypython/buildlogic-logger",
  "version": "0.1.0",
  "description": "Structured Sentry-aware application logging",
  "license": "Apache-2.0",
  "keywords": ["logging", "structured-logging", "sentry", "observability"],
  "homepage": "https://github.com/KyLamportLogic/buildlogic-governance#readme",
  "bugs": { "url": "https://github.com/KyLamportLogic/buildlogic-governance/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyLamportLogic/buildlogic-governance.git",
    "directory": "packages/logger"
  },
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.js", "default": "./dist/index.js" } },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": { "build": "tsc", "type-check": "tsc --noEmit", "test": "jest --watchman=false", "pack:check": "pnpm pack --pack-destination ../../.packs" },
  "dependencies": { "@sentry/node": "11.7.0" },
  "peerDependencies": { "newrelic": ">=12.0.0" },
  "peerDependenciesMeta": { "newrelic": { "optional": true } },
  "devDependencies": { "@types/jest": "30.0.0", "@types/node": "22.19.13", "jest": "30.5.2", "ts-jest": "29.4.12", "typescript": "5.9.3" }
}
